{
  "opencollection": "1.0.0",
  "info": {
    "name": "OpenSea Account Endpoints Auth Endpoints API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Auth Endpoints",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create an instant API key",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.opensea.io/api/v2/auth/keys"
          },
          "docs": "Creates a free-tier API key instantly without authentication. The key can be used immediately for all API endpoints. Rate limited to 2 keys per hour per IP. Keys expire after 30 days."
        }
      ]
    }
  ],
  "bundled": true
}