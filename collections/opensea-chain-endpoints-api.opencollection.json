{
  "opencollection": "1.0.0",
  "info": {
    "name": "OpenSea Account Endpoints Chain Endpoints API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Chain Endpoints",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get supported chains",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.opensea.io/api/v2/chains"
          },
          "docs": "Get all supported blockchain chains with metadata including name, native currency symbol, swap support, and block explorer information."
        }
      ]
    }
  ],
  "bundled": true
}