          "name": "Execute a token swap",
          "request": {
            "name": "Execute a token swap",
            "description": {
              "content": "Get executable transactions for token-to-token swaps. Supports same-chain and cross-chain swaps with multiple from/to assets.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v2",
                "swap",
                "execute"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "*/*"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"address\": \"<string>\",\n  \"from_assets\": [\n    {\n      \"amount\": \"<string>\",\n      \"chain\": \"<string>\",\n      \"contract\": \"<string>\"\n    },\n    {\n      \"amount\": \"<string>\",\n      \"chain\": \"<string>\",\n      \"contract\": \"<string>\"\n    }\n  ],\n  \"to_assets\": [\n    {\n      \"amount\": \"<string>\",\n      \"chain\": \"<string>\",\n      \"contract\": \"<string>\"\n    },\n    {\n      \"amount\": \"<string>\",\n      \"chain\": \"<string>\",\n      \"contract\": \"<string>\"\n    }\n  ],\n  \"recipient\": \"<string>\",\n  \"slippage_tolerance\": \"<double>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
