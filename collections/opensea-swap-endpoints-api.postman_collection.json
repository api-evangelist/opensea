        {
          "id": "283de834-b9cd-4f0f-adc0-f01c6fc5fb09",
          "name": "Get swap quote",
          "request": {
            "name": "Get swap quote",
            "description": {
              "content": "Get a quote for swapping tokens, including price details and executable transaction data.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v2",
                "swap",
                "quote"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "from_chain",
                  "value": "<string>",
                  "description": "(Required) Chain of the token to swap from"
                },
                {
                  "disabled": false,
                  "key": "from_address",
                  "value": "<string>",
                  "description": "(Required) Contract address of the token to swap from"
                },
                {
                  "disabled": false,
                  "key": "to_chain",
                  "value": "<string>",
                  "description": "(Required) Chain of the token to swap to"
                },
                {
                  "disabled": false,
                  "key": "to_address",
                  "value": "<string>",
                  "description": "(Required) Contract address of the token to swap to"
                },
                {
                  "disabled": false,
                  "key": "quantity",
                  "value": "<string>",
                  "description": "(Required) Amount to swap in the smallest unit of the token (e.g. wei for ETH)"
                },
                {
                  "disabled": false,
                  "key": "address",
                  "value": "<string>",
                  "description": "(Required) Wallet address executing the swap"
                },
                {
                  "disabled": false,
                  "key": "slippage",
                  "value": "0.01",
                  "description": "Slippage tolerance (0.0 to 0.5, default: 0.01)"
                },
                {
                  "disabled": false,
                  "key": "recipient",
                  "value": "<string>",
                  "description": "Recipient address (defaults to sender address)"
                }
              ],
              "variable": []
            },
            "header": [
