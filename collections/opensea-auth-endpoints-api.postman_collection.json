          "name": "Create an instant API key",
          "request": {
            "name": "Create an instant API key",
            "description": {
              "content": "Creates a free-tier API key instantly without authentication. The key can be used immediately for all API endpoints. Rate limited to 2 keys per hour per IP. Keys expire after 30 days.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v2",
                "auth",
                "keys"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "*/*"
              }
            ],
            "method": "POST",
            "auth": null
          },
          "response": [
            {
