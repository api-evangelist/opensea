          "name": "Cancel an order",
          "request": {
            "name": "Cancel an order",
            "description": {
              "content": "Offchain cancel a single order, offer or listing, by its order hash when protected by the SignedZone. Protocol and Chain are required to prevent hash collisions. Please note cancellation is only assured if a fulfillment signature was not vended prior to cancellation.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v2",
                "orders",
                "chain",
                ":chain",
                "protocol",
                ":protocol_address",
                ":order_hash",
                "cancel"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
