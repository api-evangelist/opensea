          "name": "[Beta] Report tool usage (metrics only)",
          "request": {
            "name": "[Beta] Report tool usage (metrics only)",
            "description": {
              "content": "[Beta] Report verified tool usage for metrics and analytics purposes only. Supports verification_type: eip3009_authorization (free tools, identity proof) or x402_settlement (paid tools, onchain USDC payment verification). This endpoint does NOT trigger any onchain transactions. This endpoint is under active development and may change without notice.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v2",
                "tools",
                "usage"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
