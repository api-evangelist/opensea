              },
              {
                "name": "timeframe",
                "value": "",
                "type": "query",
                "description": "Timeframe for history: HOUR, DAY, WEEK, MONTH"
              }
            ]
          },
          "docs": "Get net worth time series data for a wallet address over a given timeframe."
        },
